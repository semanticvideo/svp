# Pinned inputs for the SVP runtime bundle.
#
# This file is the single owner of every upstream version, download URL, and
# SHA-256 used by the runtime-bundle build scripts. The scripts refuse to use a
# download whose SHA-256 differs from the value recorded here.
#
# Changing any value here changes the runtime bundle. Record the reason in the
# commit message and rerun the verification described in README.md.
#
# Sourced by bash; keep to plain KEY=value assignments.

# --- macOS target ------------------------------------------------------------
# The repository does not declare a macOS deployment target; CMake builds use
# the SDK default. The oldest macOS the repository builds and tests on is the
# CI runner image (`macos-15` in .github/workflows/ci.yml), so the runtime
# bundle targets macOS 15.0. Raising this value drops support for workers on
# older macOS; lowering it is untested.
SVP_RUNTIME_MACOS_DEPLOYMENT_TARGET=15.0
SVP_RUNTIME_ARCH=arm64

# --- FFmpeg --------------------------------------------------------------------
# 9.0.2 is the version SVP currently runs through Homebrew; matching it keeps
# decoder, filter, and encoder output identical (plan section 3.2, gate 7.1).
# Official release tarball. The SHA-256 matches Homebrew's ffmpeg 9.0.2 pin.
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e

# --- dav1d (AV1 decoder linked into FFmpeg) -------------------------------------
# 1.5.4 is the dav1d version Homebrew's ffmpeg 9.0.2 uses today, so AV1 decode
# goes through the same decoder library version. Official VideoLAN GitLab
# release archive. The SHA-256 matches Homebrew's dav1d 1.5.4 pin.
DAV1D_VERSION=1.5.4
DAV1D_URL=https://code.videolan.org/videolan/dav1d/-/archive/1.5.4/dav1d-1.5.4.tar.bz2
DAV1D_SHA256=2abfb0c89212e6e4733a54e0ae509ec00a5b845a6360946f918806e14aedb011

# --- sherpa-onnx (speaker diarization C API) -----------------------------------
# Newest release whose C API matches the struct layout that
# packages/svp-audio/src/sherpa_diarization/private.hpp mirrors. Later
# releases change that ABI: 1.13.6 adds window_shift_ratio to the pyannote
# config (shifting every later config field), and 1.13.8 adds
# compute_confidence to the clustering config and a confidence field to each
# result segment (changing the segment array stride). Moving past 1.13.5
# requires updating SVP's mirror first. build-sherpa-onnx.sh enforces the
# layout and the dlsym names with lib/sherpa-compat-check.cpp.
SHERPA_ONNX_VERSION=1.13.5
SHERPA_ONNX_URL=https://github.com/k2-fsa/sherpa-onnx/archive/refs/tags/v1.13.5.tar.gz
SHERPA_ONNX_SHA256=99f520db7364a06be0c174a385d03f9ccdbfe08f61146055229e4a990e285262

# --- ONNX Runtime used by sherpa-onnx ------------------------------------------
# sherpa-onnx 1.13.5 pins ONNX Runtime 1.27.1 (cmake/onnxruntime-osx-arm64.cmake).
# The bundle uses Microsoft's official release package of that same version
# instead of the sherpa maintainer's repackaged archive.
ONNXRUNTIME_VERSION=1.27.1
ONNXRUNTIME_URL=https://github.com/microsoft/onnxruntime/releases/download/v1.27.1/onnxruntime-osx-arm64-1.27.1.tgz
ONNXRUNTIME_SHA256=e42b77a7281cc6e55141bf44fcfbac2c782b823a491bbb6ac33c781dd991f8a6
