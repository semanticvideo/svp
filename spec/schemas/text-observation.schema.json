{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svp.dev/schemas/text-observation.schema.json",
  "title": "text-observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text_observation_id",
    "text_region_id",
    "observation_type",
    "raw_text",
    "normalized_text",
    "confidence",
    "provenance_id"
  ],
  "properties": {
    "text_observation_id": {
      "type": "string",
      "pattern": "^text_obs_[0-9]{6,}$"
    },
    "text_region_id": {
      "type": "string"
    },
    "observation_type": {
      "type": "string"
    },
    "raw_text": {
      "type": "string"
    },
    "normalized_text": {
      "type": "string"
    },
    "language": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "layout_class": {
      "type": "string"
    },
    "source_frame_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance_id": {
      "type": "string"
    }
  }
}
