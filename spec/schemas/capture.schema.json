{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svp.dev/schemas/capture.schema.json",
  "title": "capture",
  "description": "provenance/capture.json: what the camera recorded about the shot in the source file's own metadata (Section 18.3). Every field but schema_version and sources is optional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "svp-capture-v1"
      ]
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "make": {
          "type": "string",
          "pattern": "^\\S(.*\\S)?$"
        },
        "model": {
          "type": "string",
          "pattern": "^\\S(.*\\S)?$"
        },
        "software": {
          "type": "string",
          "pattern": "^\\S(.*\\S)?$"
        },
        "serial_number": {
          "type": "string",
          "pattern": "^\\S(.*\\S)?$"
        }
      }
    },
    "lens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^\\S(.*\\S)?$"
        }
      }
    },
    "recorded": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]*[1-9])?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "start_timecode": {
      "type": "string",
      "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}[:;.][0-9]{2,3}$"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitude_m": {
          "type": "number"
        },
        "horizontal_accuracy_m": {
          "type": "number",
          "minimum": 0
        },
        "fix": {
          "type": "string",
          "enum": [
            "2d",
            "3d"
          ]
        },
        "fixed_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]*[1-9])?Z$"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "quicktime_metadata",
          "sony_nonrealtime_meta",
          "mxf_identification",
          "container_tags"
        ]
      }
    }
  },
  "examples": [
    {
      "schema_version": "svp-capture-v1",
      "camera": {
        "make": "Apple",
        "model": "iPhone",
        "software": "27.2"
      },
      "recorded": "2026-01-02T09:30:00-08:00",
      "location": {
        "latitude": 48.8584,
        "longitude": 2.2945,
        "horizontal_accuracy_m": 4.7
      },
      "sources": [
        "quicktime_metadata"
      ]
    }
  ]
}
