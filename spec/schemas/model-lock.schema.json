{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svp.dev/schemas/v1/model-lock.schema.json",
  "title": "SVP Reference Model Set Lockfile v1 RC1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_set_id",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": "svp-model-lock-1"
    },
    "model_set_id": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "model_bundle_id",
          "model_version",
          "bundle_blake3"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^model_[a-z0-9_]+$"
          },
          "model_bundle_id": {
            "type": "string",
            "pattern": "^model_[a-z0-9_]+@[^+]+\\+blake3_[0-9a-f]{12}$"
          },
          "model_version": {
            "type": "string"
          },
          "bundle_blake3": {
            "type": "string",
            "pattern": "^blake3:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
